        }
    ],
    "authors": [
        {
            "name": "tituspijean",
            "email": "tituspijean@yunohost.org",
            "role": "Developer"
        },
        {
            "name": "Yippy",
            "email": "yippym@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/tituspijean/flarum-ext-auth-ldap/issues",
        "source": "https://github.com/tituspijean/flarum-ext-auth-ldap",
        "forum": "https://discuss.flarum.org/d/9515-ldap-login-extension"
    },
    "require": {
        "flarum/core": "^2.0",
        "directorytree/ldaprecord": "^3.8.0"
